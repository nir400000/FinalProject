# coturn config for AWS EC2 (copy to /etc/turnserver.conf)
# Example for this project — adjust PUBLIC_IP and PRIVATE_IP for your instance.

listening-port=3478

# On EC2, coturn often binds the instance private IP in `ss` output.
# That is OK if external-ip uses the PUBLIC/PRIVATE mapping below.
listening-ip=172.31.17.33

fingerprint
lt-cred-mech
realm=babymonitor

# CRITICAL on AWS: map elastic/public IP -> instance private IP.
# Single "external-ip=PUBLIC" alone often still advertises 172.31.x.x relays.
external-ip=16.164.26.68/172.31.17.33

user=babymonitor:12345678

# Relay ports — open UDP 49160-49200 in the AWS security group
min-port=49160
max-port=49200

no-cli
no-tls
no-dtls

# After editing:
#   sudo systemctl restart coturn
#   turnutils_uclient -v -u babymonitor -w 12345678 16.164.26.68
#
# `ss` may still show 172.31.17.33:3478 — check relay addresses use 16.164.26.68.
